# SpaceV Configuration & Control Plane Environment Variables (.env.example)
# NOTE: Placeholders only. Do NOT commit real secrets or a live .env file.

# Celesto MicroVM Provider Configuration
CELESTO_PROVIDER=local
CELESTO_API_KEY=
CELESTO_BACKEND=firecracker
# Set CELESTO_PROVIDER=cloud and provide CELESTO_API_KEY to use Celesto Cloud.
# Set CELESTO_PROVIDER=simulation to explicitly disable real sandbox execution.

# PostgreSQL Run Ledger Database Connection
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Trusted Control Plane API Port
API_PORT=8080

# Logging & Operational Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
COMMAND_AUDIT_LOG=logs/commands.jsonl
FAILURE_TRACE_LOG=reports/failure_trace.jsonl

# LLM connection settings. SpaceV sends requests to this single endpoint.
# Leave LLM_PROVIDER blank for an OpenAI-compatible endpoint or proxy.
# Direct API examples: openai, deepseek, openrouter, groq, gemini, anthropic.
# Anthropic uses its native Messages API; the others use the OpenAI-compatible API.
# Use LLM_PROVIDER=ollama for local-only inference.
LLM_PROVIDER=
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=replace-with-your-proxy-or-provider-key
# Optional only when the endpoint/proxy has a default model. Direct providers
# such as OpenAI and Anthropic normally require a model name.
LLM_MODEL=

# Local Ollama settings (used when LLM_PROVIDER=ollama, or when no cloud key is set).
OLLAMA_BASE_URL=http://localhost:11434
FAST_CHAT_MODEL=qwen2.5:3b
PRIMARY_MODEL=qwen2.5:3b
CODER_MODEL=qwen2.5-coder:7b
VISION_MODEL=moondream:latest
UI_TARS_MODEL=ui-tars:7b
UI_TARS_MODEL_2B=ui-tars:2b
FALLBACK_MODEL=qwen2.5:7b-instruct-q5_0
OLLAMA_KEEP_ALIVE=30m
LOW_RAM_MODE=true
