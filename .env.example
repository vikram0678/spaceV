# ==============================================================================
# SpaceV Configuration & Control Plane Environment Variables (.env.example)
# NOTE: Placeholders only. Do NOT commit real secrets or a live .env file.
# ==============================================================================

# Celesto MicroVM Provider Configuration
CELESTO_PROVIDER=local
CELESTO_API_KEY=replace-with-celesto-api-key
CELESTO_BACKEND=firecracker

# PostgreSQL Run Ledger Database Connection
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Trusted Control Plane API Port
API_PORT=8080

# Logging & Operational Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
COMMAND_AUDIT_LOG=logs/commands.jsonl
FAILURE_TRACE_LOG=reports/failure_trace.jsonl

# ==============================================================================
# AI Brain Provider Selection: 'ollama' (Local/Free) OR 'openai' (Cloud API Key)
# ==============================================================================
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# OPTION A: Single Cloud API Key (OpenAI / OpenRouter / Groq)
# If LLM_PROVIDER=openai, SpaceV uses this single model for all tasks:
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION B: 100% Free Local Multi-Model (Ollama)
# If LLM_PROVIDER=ollama, SpaceV routes locally across your GPU/RAM tiers:
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
FAST_CHAT_MODEL=qwen2.5:3b
PRIMARY_MODEL=qwen2.5:3b
CODER_MODEL=qwen2.5-coder:7b
VISION_MODEL=moondream:latest
UI_TARS_MODEL=ui-tars:7b
UI_TARS_MODEL_2B=ui-tars:2b
FALLBACK_MODEL=qwen2.5:7b-instruct-q5_0
OLLAMA_KEEP_ALIVE=30m
LOW_RAM_MODE=true
